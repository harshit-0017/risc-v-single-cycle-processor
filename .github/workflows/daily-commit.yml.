name: Daily Auto Commit

on:
  schedule:
    - cron: '0 9 * * *' # Runs at midnight UTC daily
  workflow_dispatch: # Allows you to trigger it manually

jobs:
  commit:
    runs-on: ubuntu-latest
    permissions:
      contents: write

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Make a change
        run: |
          echo "Automated commit ran on $(date)" > daily_update.txt
          
      - name: Commit and push changes
        run: |
          git config --local user.name "https://github.com/harshit-0017"
          git config --local user.email "hpkumar1706@gmail.com"
          git add daily_update.txt
          git commit -m "feat: updated commit" || echo "No changes to commit"
          git push
